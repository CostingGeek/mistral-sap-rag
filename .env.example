# GCP Configuration
GCP_PROJECT=mistral-sap
BQ_DATASET=sap_rag
BUCKET=mistral-sap-rag

# GCP Service Account Key (base64 encoded JSON key)
# To create: cat service-account.json | base64 -w 0
GCP_SA_KEY_BASE64=

# Mistral API Configuration
MISTRAL_API_KEY=your_mistral_api_key_here

# Application Configuration
APP_HOST=127.0.0.1
APP_PORT=8000

# Optional: For development with local Mistral
# MISTRAL_BASE_URL=http://localhost:11434/v1
